{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://firelight.emu/schemas/runahead.json",
  "title": "Firelight runahead catalog",
  "description": "Per-game and per-platform runahead amounts. A game's runahead amount is its internal input lag in frames, which depends on both the game and the core running it.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "_note": {
      "type": "string"
    },
    "platformDefaults": {
      "description": "Fallback used when a game has no row of its own.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platformId", "core", "frames"],
        "additionalProperties": false,
        "properties": {
          "platformId": { "type": "integer" },
          "core": { "$ref": "#/definitions/core" },
          "frames": { "$ref": "#/definitions/frames" },
          "confidence": { "$ref": "#/definitions/confidence" },
          "notes": { "type": "string" }
        }
      }
    },
    "blocked": {
      "description": "Cores, or specific games, runahead must never be enabled for.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason"],
        "additionalProperties": false,
        "properties": {
          "core": { "$ref": "#/definitions/core" },
          "contentHash": { "$ref": "#/definitions/contentHash" },
          "platformId": { "type": "integer" },
          "reason": {
            "type": "string",
            "enum": [
              "hardware-rendered",
              "no-savestate-support",
              "nondeterministic-savestate",
              "too-expensive",
              "other"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contentHash", "core", "frames", "confidence"],
        "additionalProperties": false,
        "properties": {
          "contentHash": { "$ref": "#/definitions/contentHash" },
          "title": {
            "description": "Human-readable, for reviewing the file. Never used for matching.",
            "type": "string"
          },
          "platformId": { "type": "integer" },
          "core": { "$ref": "#/definitions/core" },
          "frames": { "$ref": "#/definitions/frames" },
          "measuredLag": {
            "description": "Frames between the input being read and the result being visible. `frames` normally equals this.",
            "type": "integer",
            "minimum": 0
          },
          "confidence": { "$ref": "#/definitions/confidence" },
          "unsafe": {
            "description": "Set when the core failed the savestate determinism check for this game. Forces runahead off.",
            "type": "boolean"
          },
          "method": {
            "type": "string",
            "enum": ["video-divergence", "ram-divergence", "manual"]
          },
          "scene": {
            "description": "Where in the game the measurement was taken.",
            "type": "string"
          },
          "buttons": {
            "description": "Buttons tested; the reported lag is the maximum across them.",
            "type": "array",
            "items": { "type": "string" }
          },
          "stateBytes": { "type": "integer", "minimum": 0 },
          "costRatio": {
            "description": "Core time per displayed frame relative to running normally, including the state round trip.",
            "type": "number",
            "minimum": 1
          },
          "measuredAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "firelightVersion": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "core": {
      "description": "Core DLL base name, e.g. \"mgba_libretro\" — the same key data/settings/cores/*.json uses.",
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "contentHash": {
      "description": "The rc_hash content hash the library scanner computes.",
      "type": "string",
      "minLength": 8
    },
    "frames": {
      "description": "Frames to run ahead. 0 disables runahead for this key.",
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "confidence": {
      "description": "measured = produced by `firelight measure-lag`; community = imported from an external list; unmeasured = a placeholder that must resolve to 0.",
      "type": "string",
      "enum": ["measured", "community", "unmeasured"]
    }
  }
}
