      "key": "audio-output-device",
      "label": "Audio output device",
      "group": "system-audio",
      "order": 10,
      "keywords": [
        "speaker",
        "headphones",
        "sound card",
        "playback"
      ],
      "_note": "Options are the machine's audio outputs, enumerated at runtime by the app layer (the settings lib knows nothing about hardware). '' means the system default.",
      "type": "audio-device",
      "default": ""
    },
    {
      "key": "master-volume",
      "label": "Master Volume",
      "group": "system-audio",
      "order": 10,
      "keywords": [
        "loud",
        "sound",
        "gain",
        "quiet"
      ],
      "type": "slider",
      "default": "100",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "audio-latency",
      "label": "Audio latency",
      "group": "system-audio",
      "order": 15,
      "description": "How much sound is buffered ahead, in milliseconds. Lower means the sound you hear tracks the game more closely; too low and the buffer can run dry between refills, which crackles. 64 suits most machines. Only takes effect when audio is next started.",
      "keywords": [
        "buffer",
        "latency",
        "delay",
        "lag",
        "crackle",
        "underrun",
        "responsiveness"
      ],
      "type": "spinbox",
      "default": "64",
      "min": 32,
      "max": 256,
      "step": 8,
      "advanced": true
    },
    {
      "key": "audio-muted",
      "label": "Mute audio",
      "group": "system-audio",
      "order": 20,
      "description": "Silences all game audio. Applies to every game, not just the one you're playing.",
      "keywords": [
        "mute",
        "silence",
        "quiet",
        "sound off"
      ],
      "type": "boolean",
      "default": "false"
    },
    {
      "key": "ui-sound-volume",
      "label": "Interface Sound Volume",
      "group": "system-audio",
      "order": 30,
      "description": "Loudness of menu and navigation sounds. Separate from game audio, so muting a game leaves menu feedback alone.",
      "keywords": [
        "ui",
        "menu",
        "interface",
        "navigation",
        "click",
        "sound"
      ],
      "type": "slider",
      "default": "100",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "volume",
      "label": "Game Volume",
      "group": "system-audio",
