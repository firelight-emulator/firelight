        "hidden"
      ],
      "type": "boolean",
      "default": "false"
    },
    {
      "key": "show-new-user-flow",
      "label": "Show the welcome flow",
      "group": "system-general",
      "order": 30,
      "description": "Shows first-run setup again the next time Firelight starts.",
      "keywords": [
        "onboarding",
        "welcome",
        "first run",
        "tutorial"
      ],
      "type": "boolean",
      "default": "true",
      "advanced": true
    },
    {
      "key": "auto-disable-keyboard-hotkeys",
      "label": "Turn keyboard hotkeys off automatically",
      "group": "system-general",
      "order": 60,
      "description": "When a system wants the keyboard to itself, stop keyboard hotkeys firing while it runs. Controller hotkeys keep working.",
      "keywords": [
        "shortcut",
        "hotkey",
        "keyboard",
        "dos",
        "amiga",
        "automatic"
      ],
      "_note": "The core says so itself via RETRO_ENVIRONMENT_SET_KEYBOARD_CALLBACK, which is what makes this possible without anyone predicting which cores need it.",
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "only-player-one-hotkeys",
      "label": "Only player one can use hotkeys",
      "group": "system-general",
      "order": 70,
      "description": "Stops other players saving, exiting or changing speed. The keyboard counts as whichever player it holds.",
      "keywords": [
        "hotkey",
        "shortcut",
        "player",
        "multiplayer",
        "co-op"
      ],
      "type": "boolean",
      "default": "false"
    },
    {
