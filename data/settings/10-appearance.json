      "group": "appearance-surfaces",
      "order": 20,
      "description": "How much the background shows through translucent panels.",
      "keywords": [
        "transparency",
        "frosted",
        "blur",
        "opacity"
      ],
      "type": "slider",
      "default": "0.55",
      "min": 0,
      "max": 1,
      "step": 0.01
    }
