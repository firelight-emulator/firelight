      "order": 10,
      "keywords": [
        "wallpaper",
        "image",
        "gradient",
        "solid"
      ],
      "type": "segmented",
      "default": "solid",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Gradient",
          "value": "gradient"
        },
        {
          "label": "Image",
          "value": "image"
        }
      ]
    },
    {
      "key": "background-color",
      "label": "Color",
      "group": "appearance-background",
      "order": 20,
      "keywords": [
        "colour",
        "wallpaper",
