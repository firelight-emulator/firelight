<RCC>
    <qresource prefix="/">
        <file>qtquickcontrols2.conf</file>
    </qresource>
    <qresource prefix="/sfx">
        <file alias="switch-on">assets/sfx/switchon.wav</file>
        <file alias="switch-off">assets/sfx/switchoff.wav</file>
        <file alias="open-rewind">assets/sfx/openrewind.wav</file>
        <file alias="ui-bump">assets/sfx/uibump.wav</file>
        <file alias="default-notification">assets/sfx/defaultnotification.wav</file>
        <file alias="start-game">assets/sfx/startgame.wav</file>
        <file alias="menu-move">assets/sfx/menumove.wav</file>
        <file alias="close-quick">assets/sfx/closequick.wav</file>
        <file alias="open-quick">assets/sfx/openquick.wav</file>
        <file alias="nope">assets/sfx/nope.wav</file>
        <file alias="click">assets/sfx/click.wav</file>
        <file alias="blip">assets/sfx/switch2/deck_ui_misc_10.wav</file>
        <file alias="select-radio">assets/sfx/switch2/bubble.wav</file>
        <file alias="bump">assets/sfx/switch2/deck_ui_bumper_end.wav</file>
        <file alias="button-nav">assets/sfx/switch2/button_nav.wav</file>
        <file alias="game-tile-focus">assets/sfx/switch2/game_view_nav.wav</file>
        <file alias="show-modal">assets/sfx/switch2/deck_ui_into_game_detail.wav</file>
        <file alias="back">assets/sfx/switch2/deck_ui_hide_modal.wav</file>
        <file alias="activate-game">assets/sfx/switch2/activategame.wav</file>
        <file alias="show-dialog">assets/sfx/switch2/show_dialog.wav</file>
        <file alias="check">assets/sfx/switch2/User Interface, Click, UI Buttons, Select, Menu SND115479 - Pitch 356_4.wav</file>
        <file alias="uncheck">assets/sfx/switch2/User Interface, Click, UI Buttons, Select, Menu SND115479 - Pitch 282_8.wav</file>
        <file alias="sticky-small">assets/sfx/switch2/Water, Splash, Splat, Single, Small SND58962.wav</file>
        <file alias="snap-medium">assets/sfx/switch2/Toys, Misc, Sticky Hand, Impact, Hit Human Hand SND79065 - Pitch 126_0.wav</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="lexend">assets/fonts/Lexend-VariableFont_wght.ttf</file>
        <file alias="noto-sans">assets/fonts/NotoSans-VariableFont_wdth,wght.ttf</file>
        <file alias="symbols">assets/fonts/MaterialSymbolsRounded[FILL,GRAD,opsz,wght].ttf</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="app-icon">assets/img/icon.ico</file>
        <file alias="retroachievements-banner">assets/img/retroachievements_banner.png</file>
        <file alias="firelight-logo">assets/img/firelight_logo.svg</file>
        <file alias="firelight-logo-inverted">assets/img/white-logo-orange-bg.png</file>
        <file alias="firelight-logo-white">assets/img/firelight-logo-white.png</file>
    </qresource>
