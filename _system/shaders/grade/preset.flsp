{
  "name": "Color Grade",
  "parameters": [
    { "key": "temperature", "label": "Temperature", "min": -1.0, "max": 1.0, "step": 0.05, "default": 0.0 },
    { "key": "saturation", "label": "Saturation", "min": 0.0, "max": 2.0, "step": 0.05, "default": 1.0 },
    { "key": "contrast", "label": "Contrast", "min": 0.5, "max": 1.5, "step": 0.05, "default": 1.0 },
    { "key": "brightness", "label": "Brightness", "min": 0.5, "max": 1.5, "step": 0.05, "default": 1.0 }
  ],
  "passes": [
    { "fragment": "shader.frag", "scale": 1.0, "filter": "nearest", "wrap": "clamp" }
  ]
}
